# Export these variables; this module does not automatically read .env files.
# Primary: local Qwen2.5 3B through Ollama (no Gemini key needed on success).
LLM_PRIMARY_MODEL=ollama_chat/qwen2.5:3b
OLLAMA_API_BASE=http://localhost:11434
LLM_PRIMARY_TIMEOUT_SECONDS=60

# Backup: used only when the primary provider call raises an error.
LLM_FALLBACK_MODEL=gemini/gemini-3.8-flash
LLM_FALLBACK_TIMEOUT_SECONDS=30
GEMINI_API_KEY=

